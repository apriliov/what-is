# Discord application (https://discord.com/developers/applications -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional. Defaults to https://<your-domain>/api/auth/callback. Must match the Redirect in the Discord portal.
# DISCORD_REDIRECT_URI=

# Long random string used to sign login cookies, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Discord user IDs allowed to post announcements and run giveaways, separated by commas
ADMIN_DISCORD_IDS=

# Upstash Redis (free). Vercel Marketplace -> Upstash adds the KV_REST_API_* names automatically; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
